# Optional waitlist form endpoint (Formspree, Getform, Basin, etc.).
# `/api/waitlist` prefers WAITLIST_ENDPOINT (server-only). If that is unset,
# it falls back to NEXT_PUBLIC_WAITLIST_ENDPOINT so existing Vercel config
# keeps working. Leave both unset for the local demo success state.
# Never commit API keys.
#
# WAITLIST_ENDPOINT=https://formspree.io/f/your-form-id
WAITLIST_ENDPOINT=
# NEXT_PUBLIC_WAITLIST_ENDPOINT=https://formspree.io/f/your-form-id
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Optional canonical site URL for Open Graph (custom domain).
# Leave unset/empty on Vercel — VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL
# is used automatically. Set this only to override with a real https origin.
# NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SITE_URL=
