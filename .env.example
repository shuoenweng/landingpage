# Optional waitlist form endpoint (Formspree, Getform, Basin, etc.)
# Leave unset for the local demo success state (no email is sent).
# Never commit API keys — this public URL is enough for most form services.
#
# NEXT_PUBLIC_WAITLIST_ENDPOINT=https://formspree.io/f/your-form-id
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Canonical site URL for Open Graph images (used in production)
# NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SITE_URL=
